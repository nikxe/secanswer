# ---------------------------------------------------------------------------
# OpenAI-compatible endpoint (Ollama running locally, or any vLLM/OpenAI host)
# Same code runs against Ollama on your machine or RunPod in the cloud:
# just change the URL + model names.
# ---------------------------------------------------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama

# Embeddings via the same OpenAI-compatible endpoint (Ollama nomic-embed-text)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=ollama
EMBEDDING_DIM=768

# Postgres + pgvector
DATABASE_URL=postgresql://secanswer:secanswer@localhost:5432/secanswer

# Idempotency: if unset, a deterministic run_id is derived from the workflow state.
