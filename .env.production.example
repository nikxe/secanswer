# ---------------------------------------------------------------------------
# Cloud deployment (v2): same code, different endpoints. Copy to `.env` on the
# backend host. Everything else is identical to local.
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://api.runpod.ai/v2/<endpoint-id>/openai/v1
LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
LLM_API_KEY=<RUNPOD_API_KEY>
# Embeddings usually stay local (Ollama) or on the backend host — leave empty to
# reuse LLM_BASE_URL, or set a separate OpenAI-compatible embeddings endpoint.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=ollama
EMBEDDING_DIM=768
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
